# Copy to .env for local runs. On Vercel, set these under
# Project Settings -> Environment Variables instead. Never commit real keys.

# Optional: password for the "admin" login. Leave empty for an open site.
ADMIN_PASSWORD=

# AI provider: gemini or openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
MONITOR_GEMINI_MODEL=gemini-3.5-flash-lite
# Reads advert images where Windows OCR is unavailable (the Vercel server).
AI_OCR_ENABLED=true
OCR_GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Vercel Blob store token (added automatically when a Blob store is connected
# to the Vercel project). Needed for the office PC to publish results.
BLOB_READ_WRITE_TOKEN=

# Optional tuning (defaults shown)
# KEEP_SOURCE_PDF=false
# MAX_UPLOAD_MB=80
# MAX_CHUNK_CHARS=45000
# MAX_STORIES_PER_CHUNK=50
# AI_REQUEST_TIMEOUT_SECONDS=30
# MONITOR_AI_WORKERS=4
# MONITOR_AI_TIMEOUT_SECONDS=90
# MONITOR_OCR_WORKERS=3
# BLOB_KEEP_DAYS=45

# Local only - leave unset on Vercel so temporary storage is used.
# DATABASE_PATH=data/news_agent.db
# UPLOAD_DIR=data/uploads
# REPORT_DIR=reports/manual
