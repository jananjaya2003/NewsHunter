{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run News Hunter web app",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/windows/run_web_app.ps1"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Lint (ruff)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "ruff", "check", "."],
            "problemMatcher": []
        },
        {
            "label": "Run tests",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "pytest", "-q"],
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
