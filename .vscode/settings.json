{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python.terminal.useEnvFile": true,
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["tests"],
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.rulers": [100]
    },
    // Hide generated folders from the Explorer and search.
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/*.egg-info": true
    },
    "search.exclude": {
        ".venv": true,
        "data": true,
        "reports": true
    },
    // Pull teammates' changes from GitHub in the background.
    "git.autofetch": true,
    // After each commit, push it (and pull new changes) without asking.
    "git.postCommitCommand": "sync",
    "git.confirmSync": false,
    // Stage all changed files when committing from the Source Control panel.
    "git.enableSmartCommit": true,
    "git.smartCommitChanges": "all"
}
